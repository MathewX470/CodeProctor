# ==========================================
# CodeProctor - Environment Variables Example
# ==========================================
# DO NOT ADD REAL SECRETS TO THIS FILE
# Copy this to apps/web/.env and fill in the values

# 1. Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host.aws.neon.tech/neondb?sslmode=require"

# 2. Redis & Queue (Upstash)
REDIS_URL="rediss://default:password@host.upstash.io:12345"

# 3. Authentication (Better Auth)
# Generate a secret using: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secret-key"
BETTER_AUTH_URL="http://localhost:3000"

# 4. AWS S3 (For Webcam Snapshots / Uploads)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_S3_BUCKET_NAME="codeproctor-uploads"
